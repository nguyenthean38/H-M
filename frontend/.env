# true  = dùng mock server chạy ngay trong trình duyệt (dữ liệu lưu localStorage)
# false = gọi backend thật tại VITE_API_URL (xem docs/API_CONTRACT.md)
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8080/api/v1
# Độ trễ giả lập (ms) của mock server để thấy trạng thái đang tải
VITE_MOCK_DELAY=220
